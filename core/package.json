{
  "name": "@wasm-sentry/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared analysis engine for Wasm-Sentry: format sniffing, Wasm parsing, feature extraction, heuristics and risk scoring. Zero runtime dependencies so it can run in a browser extension, a Node backend or a test harness unchanged.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "inspect": "tsx scripts/inspect.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "fixtures": "tsx scripts/emit-fixtures.ts",
    "train": "tsx scripts/train-model.ts",
    "filter-corpus": "tsx scripts/filter-corpus.ts",
    "dedupe-corpus": "tsx scripts/dedupe-corpus.ts",
    "cluster-corpus": "tsx scripts/cluster-corpus.ts",
    "split-holdout": "tsx scripts/split-holdout.ts",
    "diagnose-corpus": "tsx scripts/diagnose-corpus.ts",
    "extract-sequences": "tsx scripts/extract-sequences.ts",
    "label-evidence": "tsx scripts/label-evidence.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.2"
  }
}
